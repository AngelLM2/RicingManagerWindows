// Generated by CMake (cmake/RmwTargets.cmake): every program says which version it is (Properties >
// Details). The packager and the installer suite check it: v1.8.0 shipped a v1.7 settings window and
// bar nobody could tell apart.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ricing Manager for Windows contributors"
            VALUE "FileDescription", "Ricing Manager"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "ProductName", "Ricing Manager"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
