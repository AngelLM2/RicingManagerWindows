import { Button, ScrollView, Palette } from "std-widgets.slint";
import { Api, Page } from "../api.slint";
import { Card, Hint, PageHeader, SettingRow, Chip, Problem, Metrics } from "../common.slint";
import { Words } from "../words.slint";

// A small card of the library: its picture and name; a click applies it.
component MiniRice inherits Rectangle {
    in property <string> name;
    in property <string> folder;
    in property <image> preview;
    in property <bool> has-preview;
    in property <bool> active;
    width: 196px;
    height: 150px;
    border-radius: 10px;
    clip: true;
    background: Palette.alternate-background;
    border-width: root.active || focus.has-focus ? 2px : 1px;
    border-color: root.active || focus.has-focus ? Palette.accent-background
        : touch.has-hover ? Palette.foreground.transparentize(70%) : Palette.border;
    animate border-color { duration: 150ms; }
    accessible-role: AccessibleRole.button;
    accessible-label: @tr("Apply {}", root.name);
    accessible-enabled: !Api.busy && !root.active;
    accessible-action-default => {
        if (!Api.busy && !root.active) {
            Api.apply-rice(root.folder);
        }
    }
    forward-focus: focus;

    // Tab reaches it; Space or Enter applies it, like a click.
    focus := FocusScope {
        key-pressed(event) => {
            if ((event.text == " " || event.text == "\n") && !Api.busy && !root.active) {
                Api.apply-rice(root.folder);
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        enabled: !Api.busy && !root.active;
        clicked => {
            Api.apply-rice(root.folder);
        }
    }

    VerticalLayout {
        Rectangle {
            height: 110px;
            clip: true;
            background: Palette.foreground.transparentize(90%);
            if root.has-preview: Image {
                width: parent.width;
                height: parent.height;
                source: root.preview;
                image-fit: cover;
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 6px;

            Text {
                text: root.name;
                font-size: 13px;
                font-weight: 600;
                color: Palette.foreground;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.active: Text {
                text: "\u{E73E}";
                font-family: "Segoe Fluent Icons";
                font-size: 13px;
                color: Palette.accent-background;
                vertical-alignment: center;
            }
        }
    }
}

export component HomePage inherits ScrollView {
    VerticalLayout {
        padding: 28px;
        spacing: 16px;
        alignment: start;

        PageHeader {
            title: @tr("Home");
            subtitle: @tr("What Ricing Manager manages now, and the way back.");
        }

        if Api.safe-mode: Problem {
            error: false;
            text: @tr("Safe mode: Ricing Manager stopped unexpectedly when starting, so nothing runs by itself. Restoring still works.");
        }

        // The applied rice, large.
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;

            HorizontalLayout {
                padding: 16px;
                spacing: 18px;

                // Smaller in a narrow window: at 320 px it left the name and the buttons no room.
                picture := Rectangle {
                    width: root.width < 760px ? 176px : 320px;
                    height: self.width * 9 / 16;
                    border-radius: 8px;
                    clip: true;
                    background: Palette.foreground.transparentize(90%);

                    for rice in Api.rices: Rectangle {
                        if rice.active && rice.has-preview: Image {
                            width: picture.width;
                            height: picture.height;
                            source: rice.preview;
                            image-fit: cover;
                        }
                    }

                    if Api.active-name == "": Text {
                        text: "\u{E790}";
                        font-family: "Segoe Fluent Icons";
                        font-size: 40px;
                        color: Palette.foreground.transparentize(55%);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    alignment: center;
                    horizontal-stretch: 1;

                    Hint {
                        text: Api.active-name != "" ? @tr("Applied now") : @tr("Windows as it came");
                    }

                    Text {
                        text: Api.active-name != "" ? Api.active-name : @tr("No rice applied");
                        font-size: 24px;
                        font-weight: 600;
                        color: Palette.foreground;
                        overflow: elide;
                    }

                    // One line that wraps: a row of chips ran past the card.
                    if Api.managed-names != "": Hint {
                        text: Api.managed-names;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Button {
                            text: Api.active-name != "" ? @tr("Customize") : @tr("Customize my Windows");
                            primary: true;
                            enabled: !Api.busy;
                            clicked => {
                                Api.page = Page.appearance;
                                Api.page-shown(Page.appearance);
                            }
                        }

                        Button {
                            text: @tr("Change the rice");
                            clicked => {
                                Api.page = Page.rices;
                                Api.page-shown(Page.rices);
                            }
                        }
                    }
                }
            }
        }

        // The library, to switch with one click.
        if Api.rices.length > 0: VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                Text {
                    text: @tr("Your rices");
                    font-size: Metrics.card-title-text;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-stretch: 1;
                }
                Hint {
                    text: @tr("Click one to apply it");
                    vertical-alignment: center;
                }
            }

            Flickable {
                height: 156px;
                content-width: strip.preferred-width;
                strip := HorizontalLayout {
                    spacing: 12px;
                    for rice in Api.rices: MiniRice {
                        name: rice.name;
                        folder: rice.folder;
                        preview: rice.preview;
                        has-preview: rice.has-preview;
                        active: rice.active;
                    }
                }
            }
        }

        Card {
            title: @tr("Undo");
            subtitle: @tr("Every change is recorded and can be taken back.");

            SettingRow {
                label: @tr("Undo the last rice");
                description: @tr("Back to the rice applied before this one.");
                Button {
                    text: @tr("Undo");
                    enabled: Api.can-undo && !Api.busy;
                    clicked => {
                        Api.confirm-what = "undo";
                        Api.confirm-arg = "";
                    }
                }
            }

            SettingRow {
                label: @tr("Restore the original Windows");
                description: Api.original-captured
                    ? @tr("Your wallpaper, colors, cursors and taskbar as they were before the first rice.")
                    : @tr("Nothing has been changed yet.");
                Button {
                    text: @tr("Restore");
                    enabled: Api.original-captured && !Api.busy;
                    clicked => {
                        Api.confirm-what = "restore-original";
                        Api.confirm-arg = "";
                    }
                }
            }
        }

        if Api.status-lines.length > 0: Card {
            title: @tr("Running now");

            for line in Api.status-lines: SettingRow {
                label: Words.worker(line.key);
                description: line.detail;
                Chip {
                    text: Words.state(line.state);
                    warn: line.state == "disabled" || line.state == "stopped" || line.state == "failed";
                }
            }
        }

        if Api.history.length > 0: Card {
            title: @tr("History");
            subtitle: @tr("Go back to how things were before any of these.");

            for entry in Api.history: SettingRow {
                label: entry.label;
                description: entry.when;
                Button {
                    text: @tr("Go back to before this");
                    enabled: !Api.busy;
                    clicked => {
                        Api.confirm-what = "snapshot";
                        Api.confirm-arg = entry.id;
                    }
                }
            }
        }
    }
}
