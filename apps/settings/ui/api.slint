// What the pages and the C++ side of rmw-settings share (docs/04 M7). The pages read and write
// these properties and call these callbacks; SettingsApp.cpp fills them and does the work (the
// core over IPC, files, dialogs). Texts are English here, translated by @tr (lang/).

export enum Page {
    home,
    rices,
    appearance,
    wallpapers,
    cursors,
    sounds,
    icons,
    bar,
    plugins,
    tiling,
    shortcuts,
    diagnostics,
    settings,
}

// What just happened, for the info bar. `detail` comes from the core or the file system as is.
export enum NoticeKind {
    none,
    applied,
    restored,
    restored-partly, // the rest came back; `detail` says what did not
    undone,
    saved,
    exported,
    created,
    imported,
    added,      // a .rice into the library
    shared,     // a rice packed as a .rice
    installed,
    approved,
    removed,
    bundle,
    failed,
    connecting,
    not-connected,
}

export struct Notice {
    kind: NoticeKind,
    detail: string,
    can-undo: bool,
}

export struct StatusLine {
    key: string,    // "bar", "video", "plugins", "schedule", "safe-mode", "tools"
    state: string,  // "running", "off", "stopped", "starting", "disabled", "on" ...
    detail: string,
}

export struct HistoryRow {
    id: int,
    label: string,
    when: string,
}

export struct RiceRow {
    name: string,
    folder: string,
    author: string,
    description: string,
    problem: string,
    active: bool,
    preview: image,
    has-preview: bool,
    shareable: bool, // false: it holds Wallpaper Engine files; it stays on this computer
}

export struct MonitorBox {
    key: string,
    label: string,
    primary: bool,
    // Placement in the map, 0..1 of its width and height.
    x: float,
    y: float,
    w: float,
    h: float,
    rule: int,          // the wallpaper rule that applies there, or -1
    preview: image,
    has-preview: bool,
}

// A layer of particles over a wallpaper (M12).
export struct ParticleRow {
    kind: int,     // 0 sparkles, 1 stars, 2 snow, 3 rain, 4 petals, 5 fireflies, 6 magic, 7 notes, 8 hearts, 9 bubbles
    color: string, // "#RRGGBB" or "palette.<name>"; "" is the kind's own
    count: int,
    size: float,   // 0.25..4
    speed: float,  // 0..4
    glow: bool,
}

export struct WallRule {
    match: string,
    match-index: int, // in match-choices
    match-label: string,
    kind: int,      // 0 image, 1 slideshow, 2 video, 3 color
    source: string,
    fit: int,       // 0 fill, 1 fit, 2 stretch, 3 center, 4 tile
    fallback: string,
    color: string,  // "#RRGGBB"
    interval: int,  // minutes (slideshow)
    shuffle: bool,
    preview: image,
    has-preview: bool,
    // Effects (M12), neutral when the rice leaves them out.
    brightness: float, // -1..1
    contrast: float,   // 0..2
    saturation: float, // 0..2
    hue: float,        // -180..180
    speed: float,      // 0.25..4 (videos)
    blur: float,       // 0..40
    parallax: float,   // 0..1
    zoom: float,       // 0..1
    vignette: float,   // 0..1
    particles: [ParticleRow],
    live: bool,        // drawn by Ricing Manager: effects or particles
}

// A Wallpaper Engine wallpaper found on this computer (M12).
export struct EngineItem {
    title: string,
    kind: string,   // as people read it: "Video", "Scene"...
    usable: bool,
    note: string,   // what using it does
    preview: image,
    has-preview: bool,
}

export struct SwatchColor {
    color: color,
    hex: string,
}

export struct CursorPreview {
    role: string,
    image: image,
}

export struct WidgetChip {
    id: string,
    label: string,
    plugin: bool,
}

export struct WidgetChoice {
    id: string,
    label: string,
}

export struct BarModel {
    monitor: string,
    monitor-index: int, // in match-choices
    position: int,      // 0 top, 1 bottom, 2 left, 3 right
    mode: int,          // 0 reserve, 1 float
    thickness: int,
    length-percent: bool,
    length: int,        // % or px
    margin-top: int,
    margin-right: int,
    margin-bottom: int,
    margin-left: int,
    radius: int,
    background: int,    // 0 solid, 1 transparent, 2 acrylic, 3 mica
    tint: string,       // "#RRGGBB", "palette.x" or ""
    opacity: int,       // 0..100
    foreground: string,
    autohide: bool,
    hide-native: bool,
    skin: string,
    style: int,         // 0 its own, 1 windows, 2 dock, 3 island, 4 status, 5 side (M10)
    length-auto: bool,  // as long as what it shows
    left: [WidgetChip],
    center: [WidgetChip],
    right: [WidgetChip],
}

export struct Permission {
    name: string,
    description: string,
    sensitive: bool,
}

export struct PluginRow {
    id: string,
    name: string,
    version: string,
    author: string,
    description: string,
    state: string,      // "running", "enabled", "disabled", "needs-approval", "stopped", "broken"
    detail: string,     // why it stopped, what it needs
    permissions: [Permission],
    dev: bool,
    can-enable: bool,   // an action or rule plugin: runs without a rice when turned on
    has-config: bool,
    in-rice: bool,      // the edited rice uses it
}

export struct ConfigField {
    key: string,
    label: string,
    kind: int,          // 0 text, 1 integer, 2 number, 3 toggle, 4 choice, 5 color
    value: string,
    choices: [string],
    help: string,
}

export struct ActionChoice {
    name: string,
    label: string,
}

export struct HotkeyRow {
    keys: string,
    action: string,
    rice: string,
    app: string,
    app-name: string,
    problem: string,
}

// A tiling key (M13): its command (the name in [tiling.keys]) and the keys, "" for none.
export struct TilingKeyRow {
    command: string,
    keys: string,
    problem: string,
}

// A tiling rule for an app. Class and title come from settings.toml and are kept as they are.
export struct TilingRuleRow {
    app: string,
    window-class: string,
    title: string,
    action: int,        // 0 floats, 1 left alone, 2 opens on a workspace
    workspace: int,     // 1..9
}

// A sound event of the edited rice (M14).
export struct SoundRow {
    event: string,      // its name in [sounds.events]
    file: string,       // the .wav in the rice, or ""
    silent: bool,       // set to no sound
}

// An icon of the edited rice (M14): a desktop icon, a user folder or a program.
export struct IconRow {
    key: string,        // its name in [icons] / [icons.folders], or the program ("firefox.exe")
    file: string,       // the .ico in the rice, or ""
}

export struct RuleRow {
    when: int,          // 0 time, 1 battery, 2 plugged in, 3 monitor connected
    at: string,
    monitor: string,
    action: string,
    rice: string,
    app: string,
    app-name: string,
}

export struct AppChoice {
    id: string,
    name: string,
}

export struct ProcessRow {
    name: string,
    pid: int,
    memory: string,
    cpu: string,
    role: string,
}

export global Api {
    // ---- the window ------------------------------------------------------------------------
    in-out property <Page> page: Page.home;
    in property <string> version;
    in property <bool> connected;
    in property <bool> busy;            // an operation runs in the core
    in property <Notice> notice;
    callback dismiss-notice();
    callback undo-last();               // the info bar's "Undo"
    // A question before something that cannot be taken back: the pages set what and arg, the
    // window asks, `confirmed` runs it.
    in-out property <string> confirm-what;
    in-out property <string> confirm-arg;
    callback confirmed(string /* what */, string /* arg */);
    callback page-shown(Page);

    // ---- home ------------------------------------------------------------------------------
    in property <string> active-name;
    in property <string> active-folder;
    in property <[string]> managed;     // module names: appearance, wallpaper, cursors, sounds, taskbar, bar, tweaks
    in property <bool> safe-mode;
    in property <bool> original-captured;
    in property <[StatusLine]> status-lines;
    in property <[HistoryRow]> history;
    in property <bool> can-undo;

    // ---- rices -----------------------------------------------------------------------------
    in property <[RiceRow]> rices;
    callback apply-rice(string /* folder */);
    callback edit-rice(string /* folder */);
    callback duplicate-rice(string /* folder */);
    callback open-folder(string /* folder */);
    callback add-rice-folder();
    callback import-rice();             // a .rice file, through the core's import worker
    callback share-rice(string /* folder */);
    callback new-rice();
    callback export-current();

    // ---- the rice being edited -----------------------------------------------------------------
    in property <bool> editing;
    in property <bool> preparing-edit;  // the current look is being saved as "My look" to edit it
    in property <string> edit-name;
    in property <string> edit-folder;
    in property <bool> edit-active;     // it is the applied rice: the bar follows each save
    in property <bool> edit-hand-written;
    in property <[string]> edit-warnings;
    callback apply-edited();
    callback rename-edited(string);
    callback edit-active-rice();

    // ---- appearance ------------------------------------------------------------------------
    in-out property <int> theme-mode;           // 0 leave as is, 1 light, 2 dark, 3 Windows decides, 4 schedule
    in-out property <string> light-at: "07:00";
    in-out property <string> dark-at: "19:00";
    in-out property <string> accent;            // "#RRGGBB"; "" leaves it
    in-out property <int> transparency;         // 0 leave, 1 on, 2 off
    in-out property <int> accent-on-taskbar;    // 0 leave, 1 on, 2 off
    in property <[SwatchColor]> palette-colors; // the rice's palette, for the swatches
    callback appearance-edited();

    // ---- wallpapers ------------------------------------------------------------------------
    in property <[MonitorBox]> monitors;
    in property <[string]> match-choices;       // "primary", "all", "left"... "edid:..."
    in property <[string]> match-labels;        // the same, as the user reads them
    in property <[WallRule]> rules;
    in-out property <int> selected-rule: -1;
    callback rule-field(int /* rule */, string /* field: match, kind, fit, color, interval, shuffle */, string /* value */);
    callback rule-pick(int /* rule */, int /* 0 source, 1 fallback */);
    callback rule-add(string /* match */);
    callback rule-remove(int);
    callback rule-effect(int /* rule */, string /* brightness, contrast, saturation, hue, speed, blur, parallax, zoom, vignette */, float /* value */);
    callback rule-effects-reset(int /* rule */);
    callback particle-add(int /* rule */, int /* kind */);
    callback particle-field(int /* rule */, int /* layer */, string /* field: kind, color, count, size, speed, glow */, string /* value */);
    callback particle-remove(int /* rule */, int /* layer */);
    // Wallpaper Engine (M12): what this computer has, for one rule.
    in property <bool> engine-open;
    in property <string> engine-status;
    in property <[EngineItem]> engine-items;
    callback engine-browse(int /* rule */);
    callback engine-add-folder();
    callback engine-use(int /* item */);
    callback engine-close();
    in-out property <bool> pause-fullscreen: true;
    in-out property <bool> pause-battery: true;
    in-out property <bool> pause-covered: true;
    in-out property <int> fps-limit: 30;
    callback policy-edited();

    // ---- cursors ---------------------------------------------------------------------------
    in property <bool> cursors-managed;
    in property <string> cursors-source;
    in property <[CursorPreview]> cursor-previews;
    in-out property <int> cursor-size;          // 0 leave, 1 32, 2 48, 3 64, 4 96, 5 128
    callback cursors-pick();
    callback cursors-clear();
    callback cursors-edited();

    // ---- sounds (M14) ----------------------------------------------------------------------
    in property <[SoundRow]> sound-rows;
    in-out property <bool> sounds-silence;     // [sounds] scheme = "none"
    callback sound-pick(string /* event */);
    callback sound-silence(string /* event */);
    callback sound-clear(string /* event */);
    callback sound-play(string /* event */);
    callback sounds-edited();

    // ---- other apps' windows (M14) ---------------------------------------------------------
    in-out property <int> windows-corners;     // 0 leave, 1 round, 2 small, 3 square
    in-out property <int> windows-backdrop;    // 0 leave, 1 none, 2 mica, 3 acrylic, 4 tabbed
    in-out property <int> windows-dark;        // 0 leave, 1 on, 2 off
    in-out property <string> windows-border;   // #RRGGBB, palette.<name>, none, or ""
    in-out property <string> windows-caption;
    in-out property <string> windows-title;
    in-out property <string> windows-exclude;  // "code.exe, steam.exe"
    callback windows-edited();

    // ---- the lock screen (M14) -------------------------------------------------------------
    in property <string> lock-image;           // [lockscreen] image, or ""
    in property <bool> lock-spotlight;         // [lockscreen] spotlight = true
    in-out property <int> lock-tips;           // 0 leave, 1 show, 2 hide
    callback lock-pick();
    callback lock-spotlight-on();
    callback lock-clear();
    callback lock-edited();

    // ---- icons (M14) -----------------------------------------------------------------------
    in property <[IconRow]> icon-desktop-rows;
    in property <[IconRow]> icon-folder-rows;
    in property <[IconRow]> icon-app-rows;
    in property <[IconRow]> icon-type-rows;
    in property <[IconRow]> icon-machine-rows;  // [icons.machine]: "folder", "drive" (advanced)
    in-out property <string> icon-new-program; // the program the next [icons.apps] entry is for
    in-out property <string> icon-new-type;    // the file type the next [icons.types] entry is for
    callback icon-pick(string /* "desktop" | "folder" | "app" | "type" | "machine" */, string /* key */);
    callback icon-clear(string /* kind */, string /* key */);

    // ---- the native taskbar and our bars ---------------------------------------------------
    in-out property <int> taskbar-alignment;    // 0 leave, 1 left, 2 center
    in-out property <int> taskbar-autohide;     // 0 leave, 1 on, 2 off
    in-out property <int> taskbar-task-view;    // 0 leave, 1 on, 2 off
    in-out property <int> taskbar-search;       // 0 leave, 1 hidden, 2 icon, 3 box, 4 button
    callback taskbar-edited();
    // Start (M11): ours or Windows', our pinned apps, Windows' own Start options.
    in-out property <bool> start-ours;
    in property <[AppChoice]> start-pinned;
    in-out property <int> start-layout;        // 0 leave, 1 default, 2 more pins, 3 more recommendations
    in-out property <int> start-recommended;   // 0 leave, 1 show, 2 hide
    callback start-edited();
    callback start-unpin(int);
    in property <[string]> bar-names;
    in-out property <int> selected-bar: -1;
    in-out property <BarModel> bar;
    in property <[WidgetChoice]> widget-choices;
    in property <[string]> widget-labels;       // the same, for the add menu
    callback bar-selected(int);
    callback bar-edited();
    callback bar-add();
    callback bar-remove();
    callback bar-duplicate();
    callback bar-style(int);
    // The selected bar's dock (M10): its pinned apps; pinning one uses the app list (pick-app-for 2).
    in property <bool> bar-has-dock;
    in property <[AppChoice]> dock-pinned;
    callback dock-unpin(int);
    callback bar-move-item(int /* zone */, int /* index */, int /* to zone */, int /* to index */);
    callback bar-add-item(int /* zone */, string /* id */);
    callback bar-remove-item(int /* zone */, int /* index */);

    // ---- plugins ---------------------------------------------------------------------------
    in property <[PluginRow]> plugins;
    in-out property <int> selected-plugin: -1;
    in property <[ConfigField]> plugin-config;  // the selected plugin's settings in the edited rice
    callback plugin-selected(int);
    callback plugin-install();
    callback plugin-install-file();     // a .rmwp
    callback plugin-approve(string);
    callback plugin-enable(string, bool);
    callback plugin-remove(string);
    callback plugin-use(string, bool);          // in the edited rice's [plugins] requires
    callback plugin-config-edited(string /* key */, string /* value */);
    callback plugins-refresh();

    // ---- hotkeys and rules -----------------------------------------------------------------
    in property <string> settings-problem;      // settings.toml does not read: not overwritten
    in property <[ActionChoice]> actions;
    in property <[string]> action-labels;       // the same, as the user reads them
    pure callback action-index(string) -> int;  // of an action name in actions (0 when unknown)
    pure callback match-index(string) -> int;   // of a monitor selector in match-choices
    in property <[HotkeyRow]> hotkeys;
    in property <[RuleRow]> rules-list;
    callback hotkey-add();
    callback hotkey-edited(int, HotkeyRow);
    callback hotkey-remove(int);
    callback rule-list-add();
    callback rule-list-edited(int, RuleRow);
    callback rule-list-remove(int);
    callback pick-rice-for(int /* 0 hotkey, 1 rule */, int /* index */);
    // launch.app: the window lists the installed apps; picking one sets the hotkey's or rule's app.
    callback pick-app-for(int /* 0 hotkey, 1 rule, 2 the selected bar's dock, 3 Start's pinned */, int /* index */);
    in-out property <bool> picking-app;
    in property <[AppChoice]> apps-shown;
    callback app-filter-edited(string);
    callback app-picked(string /* id; empty: cancelled */);

    // ---- tiling (M13) ----------------------------------------------------------------------
    in-out property <bool> tiling-enabled;
    in-out property <int> tiling-mode;          // 0 like Linux (our workspaces), 1 like a Mac (Windows' desktops)
    in-out property <int> tiling-layout;        // 0 dwindle, 1 master-stack, 2 columns, 3 monocle, 4 floating
    in-out property <int> tiling-workspaces;    // 1..9
    in-out property <int> tiling-gap;
    in-out property <int> tiling-outer-gap;
    in-out property <int> tiling-master;        // 10..90 (%)
    in-out property <bool> tiling-border;
    in-out property <string> tiling-border-color; // "" = the rice's accent
    in-out property <bool> tiling-admin;        // advanced mode: admin apps' windows too (the UAC asks)
    in property <[TilingKeyRow]> tiling-keys;
    in property <[TilingRuleRow]> tiling-rules;
    in property <string> tiling-problem;        // the last change was not saved: why
    callback tiling-edited();
    callback tiling-key-edited(int, string);
    callback tiling-keys-default();
    callback tiling-rule-add();
    callback tiling-rule-edited(int, TilingRuleRow);
    callback tiling-rule-remove(int);

    // ---- diagnostics -----------------------------------------------------------------------
    in property <[ProcessRow]> processes;
    in property <[string]> recent-problems;
    in property <string> data-folder;
    callback diagnostics-refresh();
    callback open-logs();
    callback support-bundle();

    // ---- settings --------------------------------------------------------------------------
    in-out property <bool> autostart;
    in-out property <bool> keep-in-tray;
    in-out property <bool> start-win-key;      // settings.toml [start] win_key (M11)
    in-out property <bool> machine-icons;      // settings.toml [icons] machine (M14, advanced)
    in-out property <int> language;             // 0 Windows' own, 1 English, 2 Português (Brasil)
    callback settings-edited();
    callback autostart-edited();
}
