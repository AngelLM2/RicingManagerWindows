// The pieces every page uses: Fluent-like cards and rows on Slint's Palette (light and dark follow
// Windows), the navigation item, a page header, a widget chip.
import { Palette, Button, ComboBox, LineEdit, Slider, Switch } from "std-widgets.slint";
import { Api } from "api.slint";

export global Metrics {
    out property <length> page-padding: 28px;
    out property <length> spacing: 12px;
    out property <length> radius: 8px;
    out property <length> small-text: 12px;
    out property <length> body-text: 14px;
    out property <length> title-text: 26px;
    out property <length> card-title-text: 16px;
}

export component Hint inherits Text {
    color: Palette.foreground.transparentize(35%);
    font-size: Metrics.small-text;
    wrap: word-wrap;
}

export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 4px;
    padding-bottom: 8px;

    Text {
        text: root.title;
        font-size: Metrics.title-text;
        font-weight: 600;
        color: Palette.foreground;
        accessible-role: AccessibleRole.text;
    }

    if root.subtitle != "": Hint {
        text: root.subtitle;
        font-size: Metrics.body-text;
    }
}

export component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    background: Palette.alternate-background;
    border-radius: Metrics.radius;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        if root.title != "": VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                font-size: Metrics.card-title-text;
                font-weight: 600;
                color: Palette.foreground;
                wrap: word-wrap;
            }

            if root.subtitle != "": Hint {
                text: root.subtitle;
            }
        }

        @children
    }
}

// A label (and a line saying what it does) on the left, its control on the right.
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    spacing: 16px;
    alignment: stretch;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.label;
            color: Palette.foreground;
            font-size: Metrics.body-text;
            wrap: word-wrap;
        }

        if root.description != "": Hint {
            text: root.description;
        }
    }

    @children
}

export component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <bool> selected;
    in property <bool> compact; // a narrow window: the icon only (the name stays for screen readers)
    callback clicked;

    height: 38px;
    border-radius: 6px;
    background: root.selected ? Palette.foreground.transparentize(90%)
        : touch.has-hover ? Palette.foreground.transparentize(95%) : transparent;
    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: focus;

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        x: 0;
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: root.selected ? Palette.accent-background : transparent;
    }

    Rectangle {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height - 6px;
        border-radius: 4px;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Palette.accent-background;
    }

    HorizontalLayout {
        padding-left: 14px; // compact: 64 px wide, the icon centered
        spacing: 12px;

        Text {
            width: 18px;
            text: root.glyph;
            font-family: "Segoe Fluent Icons";
            font-size: 15px;
            vertical-alignment: center;
            color: Palette.foreground;
        }

        if !root.compact: Text {
            text: root.text;
            vertical-alignment: center;
            color: Palette.foreground;
            font-size: Metrics.body-text;
            overflow: elide;
        }
    }
}

// A small rounded label: a widget in a bar zone, a permission, a state.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> strong;
    in property <bool> warn;
    height: 26px;
    border-radius: 13px;
    background: root.warn ? #c4314b33 : root.strong ? Palette.accent-background.transparentize(70%)
        : Palette.foreground.transparentize(92%);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Metrics.small-text;
            color: Palette.foreground;
        }
    }
}

// A square of color; clicking (or Space/Enter once Tab reaches it) picks it.
export component Swatch inherits Rectangle {
    in property <color> swatch-color;
    in property <bool> selected;
    in property <string> name;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: root.swatch-color;
    border-width: focus.has-focus ? 3px : root.selected ? 3px : 1px;
    border-color: focus.has-focus ? Palette.accent-background : root.selected ? Palette.foreground : Palette.border;
    accessible-role: AccessibleRole.button;
    accessible-label: root.name;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: focus;

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// What follows C++. A control the user moved no longer follows a plain binding (`checked: x`): these
// take their value again whenever it changes and whenever C++ shows the rice again (a save, a refusal,
// another rice or bar). v1.7 showed the previous bar's values after switching bars.
export component ValueComboBox inherits ComboBox {
    in property <int> shown;
    property <int> refreshed: Api.refreshed;
    current-index: root.shown;
    changed shown => {
        root.current-index = root.shown;
    }
    changed refreshed => {
        root.current-index = root.shown;
    }
}

export component ValueSwitch inherits Switch {
    in property <bool> shown;
    property <int> refreshed: Api.refreshed;
    checked: root.shown;
    changed shown => {
        root.checked = root.shown;
    }
    changed refreshed => {
        root.checked = root.shown;
    }
}

export component ValueSlider inherits Slider {
    in property <float> shown;
    property <int> refreshed: Api.refreshed;
    value: root.shown;
    changed shown => {
        root.value = root.shown;
    }
    changed refreshed => {
        root.value = root.shown;
    }
}

// A text box: what is being typed in it stays until Enter (or another value comes from the rice).
export component ValueLineEdit inherits LineEdit {
    in property <string> shown;
    property <int> refreshed: Api.refreshed;
    text: root.shown;
    changed shown => {
        root.text = root.shown;
    }
    changed refreshed => {
        if (!root.has-focus) {
            root.text = root.shown;
        }
    }
}

// A message under a control: a warning or an error (callers put it under an `if`: an invisible
// element still takes its place in a layout).
export component Problem inherits Rectangle {
    in property <string> text;
    in property <bool> error: true;
    border-radius: 6px;
    background: root.error ? #c4314b26 : #f7b50026;

    HorizontalLayout {
        padding: 8px;

        Text {
            text: root.text;
            wrap: word-wrap;
            color: Palette.foreground;
            font-size: Metrics.small-text;
        }
    }
}

// A round button with an icon (Segoe Fluent Icons) and a name for Narrator and the tooltip. Tab
// reaches it; Space or Enter presses it.
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Palette.accent-background;
    background: !root.enabled ? transparent
        : touch.pressed ? Palette.foreground.transparentize(82%)
        : touch.has-hover ? Palette.foreground.transparentize(90%) : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    forward-focus: focus;

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.glyph;
        font-family: "Segoe Fluent Icons";
        font-size: 15px;
        color: root.enabled ? Palette.foreground : Palette.foreground.transparentize(60%);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A whole number with − and + beside it. The mouse wheel changes it only while it has the keyboard:
// over Slint's SpinBox, scrolling the page changed thickness, margins, gaps, FPS... and applied them.
export component NumberBox inherits Rectangle {
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step-size: 1;
    in property <int> value;        // what it shows (taken again whenever it changes)
    in property <string> label;     // for Narrator
    callback edited(int);
    property <int> refreshed: Api.refreshed;
    min-width: 116px;
    preferred-width: 150px;
    min-height: row.min-height;
    accessible-role: AccessibleRole.spinbox;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step-size;
    accessible-action-increment => {
        root.step(1);
    }
    accessible-action-decrement => {
        root.step(-1);
    }
    forward-focus: input;

    changed value => {
        input.text = root.value;
    }
    changed refreshed => {
        if (!input.has-focus) {
            input.text = root.value;
        }
    }

    function set(wanted: int) {
        input.text = clamp(wanted, root.minimum, root.maximum);
        if (clamp(wanted, root.minimum, root.maximum) != root.value) {
            root.edited(clamp(wanted, root.minimum, root.maximum));
        }
    }

    function step(by: int) {
        root.set(Math.round(input.text.is-float() ? input.text.to-float() : root.value) + by * root.step-size);
    }

    // Under the box and its buttons: the wheel reaches it only where they leave it alone.
    TouchArea {
        scroll-event(event) => {
            if (!input.has-focus) {
                return reject; // the page under it scrolls
            }
            if (event.delta-y > 0) {
                root.step(1);
            } else if (event.delta-y < 0) {
                root.step(-1);
            }
            accept
        }
    }

    row := HorizontalLayout {
        spacing: 2px;
        alignment: stretch;

        input := LineEdit {
            horizontal-stretch: 1;
            min-width: 48px;
            input-type: number;
            text: root.value;
            accessible-label: root.label;
            edited(text) => {
                // Saved as it is typed, once it is a number it may be (as Slint's SpinBox did).
                if (text.is-float() && text.to-float() >= root.minimum && text.to-float() <= root.maximum
                        && Math.round(text.to-float()) != root.value) {
                    root.edited(Math.round(text.to-float()));
                }
            }
            accepted(text) => {
                root.set(text.is-float() ? Math.round(text.to-float()) : root.value);
            }
            changed has-focus => {
                if (!self.has-focus) {
                    self.text = root.value;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: "\u{E738}";
                label: @tr("Less");
                enabled: root.value > root.minimum;
                clicked => {
                    root.step(-1);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: "\u{E710}";
                label: @tr("More");
                enabled: root.value < root.maximum;
                clicked => {
                    root.step(1);
                }
            }
        }
    }
}

// Items that fill rows and go on in the next one when a row is full (chips, swatches, buttons):
// a fixed row ran past a narrow window, or past the card in Portuguese.
export component WrapRow inherits Rectangle {
    in property <length> item-width;
    in property <length> item-height;
    in property <int> count;
    in property <length> gap: 6px;
    out property <int> columns: max(1, floor((self.width + root.gap) / (root.item-width + root.gap)));
    height: max(1, ceil(root.count / root.columns)) * (root.item-height + root.gap) - root.gap;
    min-width: root.item-width;
}
