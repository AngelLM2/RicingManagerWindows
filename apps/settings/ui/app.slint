// rmw-settings (docs/04 M7, docs/07): the settings and gallery of Ricing Manager.
import { Button, LineEdit, ListView, Palette } from "std-widgets.slint";
import { Api, Page, NoticeKind, Notice } from "api.slint";
import { NavItem, Hint, IconButton, Metrics } from "common.slint";
import { Words } from "words.slint";
import { HomePage } from "pages/home.slint";
import { RicesPage } from "pages/rices.slint";
import { AppearancePage } from "pages/appearance.slint";
import { WallpapersPage } from "pages/wallpapers.slint";
import { CursorsPage } from "pages/cursors.slint";
import { SoundsPage } from "pages/sounds.slint";
import { IconsPage } from "pages/icons.slint";
import { BarPage } from "pages/bar.slint";
import { PluginsPage } from "pages/plugins.slint";
import { ShortcutsPage } from "pages/shortcuts.slint";
import { TilingPage } from "pages/tiling.slint";
import { DiagnosticsPage } from "pages/diagnostics.slint";
import { SettingsPage } from "pages/settings.slint";

export { Api, Words, Page }

component InfoBar inherits Rectangle {
    in property <Notice> notice;
    property <bool> bad: root.notice.kind == NoticeKind.failed || root.notice.kind == NoticeKind.not-connected
        || root.notice.kind == NoticeKind.restored-partly || root.notice.kind == NoticeKind.not-saved;
    background: root.bad ? #c4314b33 : Palette.accent-background.transparentize(80%);
    border-radius: Metrics.radius;
    accessible-role: AccessibleRole.text;
    accessible-label: message.text;

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;

        message := Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            wrap: word-wrap;
            color: Palette.foreground;
            text: root.notice.kind == NoticeKind.applied ? @tr("Applied: {}", root.notice.detail)
                : root.notice.kind == NoticeKind.restored ? @tr("Restored: {}", root.notice.detail)
                : root.notice.kind == NoticeKind.restored-partly ? @tr("Everything else came back. Not back: {}", root.notice.detail)
                : root.notice.kind == NoticeKind.restored-kept ? @tr("Restored. Kept the way you changed it: {}", root.notice.detail)
                : root.notice.kind == NoticeKind.undone ? @tr("Undone: {}", root.notice.detail)
                : root.notice.kind == NoticeKind.saved ? @tr("Saved in {}", root.notice.detail)
                : root.notice.kind == NoticeKind.exported ? @tr("Your current look is now the rice “{}”", root.notice.detail)
                : root.notice.kind == NoticeKind.created ? @tr("Created “{}”", root.notice.detail)
                : root.notice.kind == NoticeKind.imported ? @tr("Copied into the rice: {}", root.notice.detail)
                : root.notice.kind == NoticeKind.added ? @tr("Added to your rices: {}", root.notice.detail)
                : root.notice.kind == NoticeKind.shared ? @tr("Ready to share: {}", root.notice.detail)
                : root.notice.kind == NoticeKind.installed ? @tr("Installed {}", root.notice.detail)
                : root.notice.kind == NoticeKind.approved ? @tr("Approved {}", root.notice.detail)
                : root.notice.kind == NoticeKind.removed ? @tr("Removed {}", root.notice.detail)
                : root.notice.kind == NoticeKind.bundle ? @tr("Support bundle ready in {}", root.notice.detail)
                : root.notice.kind == NoticeKind.connecting ? @tr("Connecting to Ricing Manager…")
                : root.notice.kind == NoticeKind.not-connected ? @tr("Ricing Manager's core is not running: {}", root.notice.detail)
                : root.notice.kind == NoticeKind.copying ? @tr("Copying into the rice: {}…", root.notice.detail)
                : root.notice.kind == NoticeKind.not-saved ? @tr("Not saved, so the rice stays readable: {}", root.notice.detail)
                : @tr("That did not work: {}", root.notice.detail);
        }

        if root.notice.can-undo: Button {
            text: @tr("Undo");
            clicked => {
                Api.undo-last();
            }
        }

        IconButton {
            glyph: "\u{E711}";
            label: @tr("Close the message");
            clicked => {
                Api.dismiss-notice();
            }
        }
    }
}

export component AppWindow inherits Window {
    title: @tr("Ricing Manager");
    icon: @image-url("../../resources/icon.png");
    preferred-width: 1180px;
    preferred-height: 720px;
    // At 200% a 1080p screen has ~490 logical pixels of height for it: 560 did not fit. The pages
    // and the side bar scroll.
    min-width: 820px;
    min-height: 420px;
    background: Palette.background;
    default-font-family: "Segoe UI Variable Text";
    // Flipped by SettingsApp when the window comes back (moved, restored, another monitor): the
    // whole window is drawn again, so no part stays unpainted.
    in-out property <bool> repaint;
    // A narrow window gives the pages the room: the side bar shows icons only. Set by SettingsApp from the
    // window's size (a binding on the window's own width would loop through its layout).
    in property <bool> narrow;
    property <bool> compact-nav: root.narrow;

    function go(page: Page) {
        Api.page = page;
        Api.page-shown(page);
    }

    HorizontalLayout {
        Rectangle {
            width: root.compact-nav ? 64px : 236px;
            background: Palette.alternate-background;

            // A short window: the side bar scrolls (v1.6 cut its last items off).
            Flickable {
                content-width: self.width;
                content-height: max(self.height, nav.min-height);

            nav := VerticalLayout {
                padding: root.compact-nav ? 8px : 12px;
                spacing: 2px;
                alignment: start;

                Text {
                    text: root.compact-nav ? "RM" : "Ricing Manager";
                    font-size: 18px;
                    font-weight: 600;
                    color: Palette.foreground;
                    height: 48px;
                    horizontal-alignment: root.compact-nav ? center : left;
                    vertical-alignment: center;
                }

                NavItem {
                    text: @tr("Home");
                    glyph: "\u{E80F}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.home;
                    clicked => {
                        root.go(Page.home);
                    }
                }

                NavItem {
                    text: @tr("Rices");
                    glyph: "\u{E8B9}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.rices;
                    clicked => {
                        root.go(Page.rices);
                    }
                }

                Text {
                    text: root.compact-nav ? "" : @tr("CUSTOMIZE");
                    font-size: 11px;
                    font-weight: 600;
                    color: Palette.foreground.transparentize(45%);
                    height: root.compact-nav ? 12px : 30px;
                    vertical-alignment: bottom;
                    accessible-role: AccessibleRole.none;
                }

                NavItem {
                    text: @tr("Appearance");
                    glyph: "\u{E790}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.appearance;
                    clicked => {
                        root.go(Page.appearance);
                    }
                }

                NavItem {
                    text: @tr("Wallpapers");
                    glyph: "\u{EB9F}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.wallpapers;
                    clicked => {
                        root.go(Page.wallpapers);
                    }
                }

                NavItem {
                    text: @tr("Cursors");
                    glyph: "\u{E8B0}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.cursors;
                    clicked => {
                        root.go(Page.cursors);
                    }
                }

                NavItem {
                    text: @tr("Sounds");
                    glyph: "\u{E767}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.sounds;
                    clicked => {
                        root.go(Page.sounds);
                    }
                }

                NavItem {
                    text: @tr("Icons");
                    glyph: "\u{E71D}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.icons;
                    clicked => {
                        root.go(Page.icons);
                    }
                }

                NavItem {
                    text: @tr("Taskbar");
                    glyph: "\u{E75B}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.bar;
                    clicked => {
                        root.go(Page.bar);
                    }
                }

                NavItem {
                    text: @tr("Plugins");
                    glyph: "\u{EA86}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.plugins;
                    clicked => {
                        root.go(Page.plugins);
                    }
                }

                NavItem {
                    text: @tr("Tiling");
                    glyph: "\u{ECA5}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.tiling;
                    clicked => {
                        root.go(Page.tiling);
                    }
                }

                Text {
                    text: root.compact-nav ? "" : @tr("MORE");
                    font-size: 11px;
                    font-weight: 600;
                    color: Palette.foreground.transparentize(45%);
                    height: root.compact-nav ? 12px : 30px;
                    vertical-alignment: bottom;
                    accessible-role: AccessibleRole.none;
                }

                NavItem {
                    text: @tr("Hotkeys and rules");
                    glyph: "\u{E765}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.shortcuts;
                    clicked => {
                        root.go(Page.shortcuts);
                    }
                }

                NavItem {
                    text: @tr("Diagnostics");
                    glyph: "\u{E9D9}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.diagnostics;
                    clicked => {
                        root.go(Page.diagnostics);
                    }
                }

                NavItem {
                    text: @tr("Settings");
                    glyph: "\u{E713}";
                    compact: root.compact-nav;
                    selected: Api.page == Page.settings;
                    clicked => {
                        root.go(Page.settings);
                    }
                }
            }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;

            if Api.notice.kind != NoticeKind.none: HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 12px;

                InfoBar {
                    notice: Api.notice;
                }
            }

            if Api.page == Page.home: HomePage { }
            if Api.page == Page.rices: RicesPage { }
            if Api.page == Page.appearance: AppearancePage { }
            if Api.page == Page.wallpapers: WallpapersPage { }
            if Api.page == Page.cursors: CursorsPage { }
            if Api.page == Page.sounds: SoundsPage { }
            if Api.page == Page.icons: IconsPage { }
            if Api.page == Page.bar: BarPage { }
            if Api.page == Page.plugins: PluginsPage { }
            if Api.page == Page.tiling: TilingPage { }
            if Api.page == Page.shortcuts: ShortcutsPage { }
            if Api.page == Page.diagnostics: DiagnosticsPage { }
            if Api.page == Page.settings: SettingsPage { }
        }
    }

    // Which installed app a hotkey or a rule opens. It takes the keyboard: Esc cancels, Tab stays in
    // it (v1.7 blocked only the mouse; Tab went on to the page behind).
    if Api.picking-app: FocusScope {
        init => {
            search.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                Api.app-picked("");
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (search.has-focus) {
                    cancel-pick.focus();
                } else {
                    search.focus();
                }
                return accept;
            }
            reject
        }

        Rectangle {
            background: #00000080;

            TouchArea { }

            Rectangle {
                width: min(520px, parent.width - 48px);
                height: min(560px, parent.height - 48px);
                background: Palette.background;
                border-radius: 10px;
                border-width: 1px;
                border-color: Palette.border;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text {
                        text: @tr("Choose the app to open");
                        font-size: 18px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }

                    search := LineEdit {
                        placeholder-text: @tr("Search");
                        accessible-label: @tr("Search the apps (Enter picks the first)");
                        edited(text) => {
                            Api.app-filter-edited(text);
                        }
                        accepted => {
                            if (Api.apps-shown.length > 0) {
                                Api.app-picked(Api.apps-shown[0].id);
                            }
                        }
                    }

                    ListView {
                        vertical-stretch: 1;
                        for app in Api.apps-shown: Rectangle {
                            height: 36px;
                            border-radius: 4px;
                            background: row.has-hover ? Palette.foreground.transparentize(92%) : transparent;
                            accessible-role: AccessibleRole.button;
                            accessible-label: app.name;
                            accessible-action-default => {
                                Api.app-picked(app.id);
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                Text {
                                    text: app.name;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                }
                            }

                            row := TouchArea {
                                clicked => {
                                    Api.app-picked(app.id);
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        cancel-pick := Button {
                            text: @tr("Cancel");
                            clicked => {
                                Api.app-picked("");
                            }
                        }
                    }
                }
            }
        }
    }

    // A question before something that cannot be taken back (or is big). Esc cancels; Tab goes
    // between its two buttons only.
    if Api.confirm-what != "": FocusScope {
        init => {
            cancel-confirm.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                Api.confirm-what = "";
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (cancel-confirm.has-focus) {
                    go-confirm.focus();
                } else {
                    cancel-confirm.focus();
                }
                return accept;
            }
            reject
        }

        Rectangle {
            background: #00000080;

            TouchArea { }

            Rectangle {
                width: min(480px, parent.width - 48px);
                height: dialog.preferred-height;
                background: Palette.background;
                border-radius: 10px;
                border-width: 1px;
                border-color: Palette.border;

                dialog := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    Text {
                        font-size: 18px;
                        font-weight: 600;
                        wrap: word-wrap;
                        color: Palette.foreground;
                        text: Api.confirm-what == "restore-original" ? @tr("Restore the original Windows?")
                            : Api.confirm-what == "undo" ? @tr("Undo the last rice?")
                            : Api.confirm-what == "snapshot" ? @tr("Go back to before this change?")
                            : Api.confirm-what == "remove-plugin" ? @tr("Uninstall this plugin?")
                            : Api.confirm-what == "remove-bar" ? @tr("Remove this bar from the rice?")
                            : @tr("Are you sure?");
                    }

                    Text {
                        wrap: word-wrap;
                        color: Palette.foreground;
                        text: Api.confirm-what == "restore-original" ? @tr("Wallpaper, colors, cursors, taskbar and bars go back to how they were before the first rice. Your rices stay in their folders.")
                            : Api.confirm-what == "undo" ? @tr("The rice applied before this one comes back.")
                            : Api.confirm-what == "snapshot" ? @tr("Everything that changed since then goes back.")
                            : Api.confirm-what == "remove-plugin" ? @tr("Its files and its data are deleted: {}", Api.confirm-arg)
                            : Api.confirm-what == "remove-bar" ? @tr("Windows' taskbar comes back if no other bar hides it.")
                            : "";
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        cancel-confirm := Button {
                            text: @tr("Cancel");
                            clicked => {
                                Api.confirm-what = "";
                            }
                        }

                        go-confirm := Button {
                            text: Api.confirm-what == "remove-plugin" ? @tr("Uninstall")
                                : Api.confirm-what == "remove-bar" ? @tr("Remove")
                                : @tr("Go back");
                            primary: true;
                            clicked => {
                                Api.confirmed(Api.confirm-what, Api.confirm-arg);
                                Api.confirm-what = "";
                            }
                        }
                    }
                }
            }
        }
    }

    // A full-window layer that changes when `repaint` flips (invisible: 1/255 of black or none).
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: root.repaint ? #00000001 : #00000000;
    }
}
