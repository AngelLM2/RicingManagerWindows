// The widget's look. The bar gives every widget that declares them `foreground` (the rice's text
// color), `vertical`, `item-radius` (its highlights follow the bar's corners) and `accent`
// (Windows' accent color); the rest is yours ([widget.properties] and [widget.callbacks] in
// plugin.toml).
export component MyWidget inherits Rectangle {
    in property <color> foreground;
    in property <bool> vertical;
    in property <length> item-radius: 6px;
    in property <color> accent: #60cdff;
    in property <string> text: "…";
    callback clicked();
    min-width: label.preferred-width + 16px;
    min-height: 32px;
    border-radius: root.item-radius;
    background: touch.pressed ? root.foreground.transparentize(80%)
        : touch.has-hover ? root.foreground.transparentize(89%)
        : root.foreground.transparentize(100%);
    animate background { duration: 120ms; easing: ease-out; }
    label := Text {
        text: root.text;
        color: root.foreground;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
