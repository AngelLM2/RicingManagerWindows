// The tray's icons in a rounded pill; right click opens the app's menu.
export struct Item {
    id: int,
    icon: image,
}

component Slot inherits Rectangle {
    in property <Item> item;
    in property <color> foreground;
    callback click(int);
    callback menu(int);
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: touch.has-hover ? root.foreground.transparentize(85%) : transparent;
    Image {
        source: root.item.icon;
        width: 16px;
        height: 16px;
        image-fit: contain;
    }
    touch := TouchArea {
        clicked => { root.click(root.item.id); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                root.menu(root.item.id);
            }
        }
    }
}

export component MiniTray inherits Rectangle {
    in property <color> foreground;
    in property <bool> vertical;
    in property <[Item]> icons;
    callback click(int);
    callback menu(int);
    visible: root.icons.length > 0;
    min-height: 28px;
    border-radius: 14px;
    background: root.foreground.transparentize(92%);
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 2px;
        alignment: center;
        for item in root.icons: VerticalLayout {
            alignment: center;
            Slot {
                item: item;
                foreground: root.foreground;
                click(id) => { root.click(id); }
                menu(id) => { root.menu(id); }
            }
        }
    }
}

export component MiniTrayColumn inherits Rectangle {
    in property <color> foreground;
    in property <bool> vertical;
    in property <[Item]> icons;
    callback click(int);
    callback menu(int);
    visible: root.icons.length > 0;
    min-width: 28px;
    border-radius: 14px;
    background: root.foreground.transparentize(92%);
    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 2px;
        alignment: center;
        for item in root.icons: HorizontalLayout {
            alignment: center;
            Slot {
                item: item;
                foreground: root.foreground;
                click(id) => { root.click(id); }
                menu(id) => { root.menu(id); }
            }
        }
    }
}
