// "21° Clear"; hover shows the place and the time of the reading.
export component Weather inherits Rectangle {
    in property <color> foreground;
    in property <bool> vertical;
    in property <string> text: "…";
    in property <string> tip;
    callback clicked();
    min-width: label.preferred-width + 16px;
    min-height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? rgba(255, 255, 255, 0.12) : transparent;
    label := Text {
        text: touch.has-hover && root.tip != "" ? root.tip : root.text;
        color: root.foreground;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
